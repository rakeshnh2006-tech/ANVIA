# ─────────────────────────────────────────────────
# SAKHI Server Environment Variables
# Copy to .env and fill in your values
# NEVER commit actual keys to source control
# ─────────────────────────────────────────────────

# Server port
PORT=3001

# Allowed client origin for CORS
CLIENT_URL=http://localhost:5173

# ─── Supabase ──────────────────────────────────────────
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — NEVER expose in frontend
# Used only server-side for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── AI Provider ───────────────────────────────────────
# Set AI_PROVIDER to one of: openai | google | demo
# Leave as "demo" for development without an AI provider
AI_PROVIDER=demo

# Your AI provider API key
# For OpenAI: https://platform.openai.com/api-keys
# For Google AI: https://aistudio.google.com/app/apikey
AI_API_KEY=

# Model to use
# OpenAI examples: gpt-4o-mini, gpt-4o
# Google examples: gemini-1.5-flash, gemini-1.5-pro
AI_MODEL=gpt-4o-mini
